# Copy to .env.local for local development. Put production values in host dashboards.
# Never commit real credentials.
MONGODB_URI=mongodb://127.0.0.1:27017/heart-witness
REDIS_URL=redis://127.0.0.1:6379
SITE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
ADMIN_EMAILS=

# worker: claude or gemini. Gemini is also required for illustrations.
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Set false to deploy without email notifications or Resend credentials.
EMAIL_ENABLED=true
RESEND_API_KEY=
EMAIL_FROM=Heart Witness <noreply@your-domain.example>

# Optional: where jobs and rate limits are stored — redis (default) or mongo.
# With mongo, REDIS_URL isn't needed. Use the same value for web and worker.
# QUEUE_BACKEND=redis
# MONGO_QUEUE_POLL_SECONDS=5

# Optional: override defaults in worker deployments.
MODERATION_CONCURRENCY=3
ILLUSTRATION_CONCURRENCY=2
# How long an idle worker waits on Redis before checking again, and how often
# it looks for jobs abandoned by a crash. Higher = fewer Redis commands.
WORKER_IDLE_WAIT_SECONDS=120
WORKER_STALLED_CHECK_SECONDS=300
